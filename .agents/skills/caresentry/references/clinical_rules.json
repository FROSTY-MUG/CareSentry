  "renal_clearance_thresholds": [
    {
      "drug_name": "metformin",
      "aliases": ["metformin", "glucophage", "fortamet", "glumetza", "riomet"],
      "egfr_cutoff_ml_min": 30,
      "operator": "lt",
      "action": "CONTRAINDICATED",
      "severity": "CRITICAL",
      "rationale": "High risk of life-threatening metformin-associated lactic acidosis (MALA) when eGFR < 30 mL/min/1.73m²"
    },
    {
      "drug_name": "spironolactone",
      "aliases": ["spironolactone", "aldactone", "carospir"],
      "egfr_cutoff_ml_min": 30,
      "operator": "lt",
      "action": "CONTRAINDICATED",
      "severity": "CRITICAL",
      "rationale": "Severe risk of fatal hyperkalemia and acute kidney injury worsening in advanced renal impairment"
    },
    {
      "drug_name": "high-dose nsaids",
      "aliases": ["ibuprofen", "advil", "motrin", "naproxen", "aleve", "meloxicam", "ketorolac", "toradol", "indomethacin", "diclofenac"],
      "egfr_cutoff_ml_min": 30,
      "operator": "lt",
      "action": "CONTRAINDICATED",
      "severity": "CRITICAL",
      "rationale": "Inhibits renal prostaglandin synthesis, causing afferent arteriolar vasoconstriction and precipitating acute-on-chronic renal failure"
    },
    {
      "drug_name": "nitrofurantoin",
      "aliases": ["nitrofurantoin", "macrobid", "macrodantin"],
      "egfr_cutoff_ml_min": 30,
      "operator": "lt",
      "action": "CONTRAINDICATED",
      "severity": "HIGH",
      "rationale": "Ineffective urinary concentrations and increased risk of peripheral neuropathy toxicity"
    },
    {
      "drug_name": "colchicine",
      "aliases": ["colchicine", "colcrys", "mitigare"],
      "egfr_cutoff_ml_min": 30,
      "operator": "lt",
      "action": "CONTRAINDICATED",
      "severity": "HIGH",
      "rationale": "Cumulative toxicity resulting in severe neuromyopathy and bone marrow suppression"
    }
  ],
