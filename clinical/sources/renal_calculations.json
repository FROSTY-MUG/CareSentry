{
  "version": "1.0.0",
  "name": "Renal Calculations",
  "description": "Cockcroft-Gault and CKD-EPI 2021 formulas for estimating renal function.",
  "source": "renal_calculations.json",
  "retrieval_date": "2026-10-10",
  "license": "CC-BY 4.0 - derived from KDIGO and FDA labeling",
  "formulas": {
    "cockcroft_gault": {
      "description": "Cockcroft-Gault Creatinine Clearance (CrCl)",
      "equation": "CrCl = (140 - age) * weight / (72 * creatinine) * (0.85 if female)",
      "variables": ["age", "sex", "weight_kg", "creatinine_mg_dL"],
      "units": {
        "crcl": "mL/min",
        "creatinine": "mg/dL",
        "weight": "kg",
        "age": "years"
      },
      "note": "Overestimates CrCl in elderly; cG-cystatin C equation may be better"
    },
    "ckd_epi_2021": {
      "description": "CKD-EPI 2021 eGFR (race-free)",
      "equation": "eGFR = 142 * min(Scr/k, 1)^a * max(Scr/k, 1)^-1.200 * 1.012 (if female) * 1.159 (if Black)",
      "variables": ["age", "sex", "race", "creatinine_mg_dL"],
      "k": "0.7 for females, 0.9 for males",
      "a": "-0.241 for females, -0.202 for males",
      "units": {
        "egfr": "mL/min/1.73m2",
        "creatinine": "mg/dL",
        "age": "years"
      },
      "note": "Replaces CKD-EPI 2012 with race-free coefficient"
    }
  },
  "renal_thresholds": {
    "metformin_egfr_cutoff_ml_min": 30,
    "spironolactone_egfr_cutoff_ml_min": 30,
    "nsaid_egfr_cutoff_ml_min": 30,
    "metformin_action": "CONTRAINDICATED",
    "spironolactone_action": "CONTRAINDICATED",
    "nsaid_action": "CONTRAINDICATED"
  },
  "worked_examples": [
    {
      "description": "Metformin contraindication example",
      "age": 72,
      "sex": "female",
      "weight_kg": 75,
      "creatinine_mg_dL": 1.8,
      "cockcroft_gault_crcl": 42.1,
      "ckd_epi_2021_egfr": 44,
      "metformin_status": "CONTRAINDICATED (eGFR < 30 not met, but CrCl 42 > 30)",
      "spironolactone_status": "CONTRAINDICATED (CrCl < 30 would trigger, but 42 > 30)",
      "nsaid_status": "CONTRAINDICATED (CrCl < 30 would trigger, but 42 > 30)"
    },
    {
      "description": "Severe renal impairment example",
      "age": 68,
      "sex": "male",
      "weight_kg": 85,
      "creatinine_mg_dL": 3.2,
      "cockcroft_gault_crcl": 28.4,
      "ckd_epi_2021_egfr": 29.,
      "metformin_status": "CONTRAINDICATED (eGFR < 30 CrCl < 30)",
      "spironolactone_status": "CONTRAINDICATED (CrCl < 30)",
      "nsaid_status": "CONTRAINDICATED (CrCl < 30)"
    }
  ]
}